APP_NAME=AuditPilot Local
API_V1_PREFIX=/api/v1
PYTHON_EXECUTABLE=
BACKEND_SCHEME=http
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_PUBLIC_URL=
FRONTEND_SCHEME=http
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=3000
FRONTEND_PUBLIC_URL=
FRONTEND_API_BASE_URL=
AUTH_SECRET_KEY=
# Optional override. Local mode creates backend/data/.credential_encryption_key automatically.
CREDENTIAL_ENCRYPTION_KEY=
AUTH_TOKEN_TTL_SECONDS=604800
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_RESET_PASSWORD=false
HUMAN_CHECK_CHALLENGE_TTL_SECONDS=300
HUMAN_CHECK_PROOF_TTL_SECONDS=300
HUMAN_CHECK_MIN_COMPLETION_MS=1200
DATABASE_URL=sqlite:///./backend/data/auditpilot.db
REDIS_URL=redis://127.0.0.1:6379/0
SQL_ECHO=false
DEFAULT_USER_ID=00000000-0000-0000-0000-000000000001
REPORT_HISTORY_LIMIT=200
UPLOAD_MAX_FILES=1000
UPLOAD_MAX_FILE_BYTES=209715200
UPLOAD_MAX_TOTAL_BYTES=209715200
EXTRACTION_MAX_FILES=10000
EXTRACTION_MAX_TOTAL_BYTES=524288000
EXTRACTION_MAX_RATIO=200
USER_STORAGE_QUOTA_BYTES=2147483648
LLM_ENABLED=true
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_REASONING_EFFORT=high
DEEPSEEK_THINKING_ENABLED=true
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=4096
LLM_MAX_REVIEW_FILES=6
LLM_MAX_FILE_CHARS=6000
LLM_MAX_FINDINGS=8
LLM_DEFAULT_MONTHLY_TOKEN_LIMIT=1000000
LLM_CONTEXT_INDEX_MAX_FILES=160
LLM_CONTEXT_REFERENCE_LIMIT=3
JAVA_AUDIT_SKILLS_ENABLED=true
JAVA_AUDIT_SKILLS_ROOT=
JAVA_LLM_FULL_FILE_CONTEXT=true
JAVA_LLM_MAX_REVIEW_FILES=4
JAVA_HEURISTIC_REQUIRES_CORROBORATION=true
JAVA_CORROBORATION_LINE_RADIUS=8
